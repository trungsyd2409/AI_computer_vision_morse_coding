# Copy this file to .env and fill it in. Never commit .env.
# Without a key the app runs in mock mode with scripted replies.
ANTHROPIC_API_KEY=

# Model used for replies. A small, fast model keeps the cost and delay low.
XENO_MODEL=claude-haiku-5-5

# Where the local server listens. 127.0.0.1 keeps it private to your computer.
XENO_HOST=127.0.0.1
XENO_PORT=8000

# Daily limits (UTC day). They protect your API bill.
XENO_DAILY_PER_IP=200
XENO_DAILY_TOTAL=1000

# Upper bound on tokens the model may write per reply.
XENO_MAX_TOKENS=200
