# Copy this file to .env and fill it in. Never commit .env.
# Without a key the app runs in mock mode with canned replies.
# Which models to try, and in what order, is set in config.json.

# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Anthropic key: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Only used when config.json is missing or has no "models" list:
# XENO_PROVIDER is "gemini" or "anthropic", XENO_MODEL a model name for that provider.
XENO_PROVIDER=
XENO_MODEL=

# Passwords for the web page. Leave both empty to run without a sign-in screen (local use only).
# Master password: can open Settings. User password: can chat but cannot open Settings.
# Use long, different values. With only a user password set, the server refuses to start.
XENO_MASTER_PASSWORD=
XENO_USER_PASSWORD=
# Signs the login cookie. Leave empty and every restart signs everyone out.
# Set a long random value to keep people signed in across restarts, change it to sign everyone out.
XENO_SESSION_SECRET=
# How long a sign-in lasts, in hours.
XENO_SESSION_HOURS=12
# Set to 1 when the site is served over https, so the cookie is only sent over https.
XENO_SECURE_COOKIE=0

# Where the local server listens. 127.0.0.1 keeps it private to your computer.
XENO_HOST=127.0.0.1
XENO_PORT=8000

# Daily limits (UTC day). They protect your API bill.
XENO_DAILY_PER_IP=200
XENO_DAILY_TOTAL=1000

# Upper bound on tokens the model may write per reply.
XENO_MAX_TOKENS=200
